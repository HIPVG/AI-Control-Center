{
  "task": "Create only compact Plan Skeletons by selecting Action IDs. Do not list issue IDs or explanations.",
  "decision_response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "decision_status",
      "plans"
    ],
    "properties": {
      "decision_status": {
        "type": "string",
        "enum": [
          "ACTION_REQUIRED",
          "NO_ACTION_REQUIRED",
          "INSUFFICIENT_INFORMATION"
        ]
      },
      "plans": {
        "type": "array",
        "minItems": 0,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "plan_intent",
            "actions"
          ],
          "properties": {
            "plan_id": {
              "type": "string",
              "minLength": 1
            },
            "plan_intent": {
              "type": "string",
              "enum": [
                "DELIVERY_PRIORITY",
                "COST_PRIORITY",
                "QUALITY_PRIORITY",
                "CUSTOMER_IMPACT_PRIORITY",
                "CAPACITY_RECOVERY",
                "BALANCED"
              ]
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "teacher_api_called": false
}
