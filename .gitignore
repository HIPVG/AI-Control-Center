__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
# Disposable pytest workspaces, including nested Git fixtures.
.pytest-*/
.venv/
# Runtime state and retained local evidence stay on the operator host.
state/**
!state/.gitkeep
logs/*
# Local exports and experimental dependency/model sandboxes are not product source.
output/
poc/
docs.zip
config/runtime.local.yaml
config/budget.local.yaml
!logs/.gitkeep
